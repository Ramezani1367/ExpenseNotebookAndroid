<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="rtl" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/widget_plus" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="5dp" android:background="@drawable/widget_plus_bg" android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="27sp" />
    <LinearLayout android:layout_width="102dp" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/widget_date_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="چهارشنبه" android:textColor="#717171" android:textSize="18sp" android:textStyle="bold" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="7dp" android:background="#AEB6B1" />
        <TextView android:id="@+id/widget_date_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="۱ مرداد ۱۴۰۵" android:textColor="#1A5E3A" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="110dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:orientation="vertical" android:gravity="right">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_gear" android:layout_width="18dp" android:layout_height="18dp" android:gravity="center" android:text="⚙" android:textColor="#888888" android:textSize="10sp" /><TextView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="خرج کرد امروز" android:textColor="#777777" android:textSize="10sp" /></LinearLayout>
        <TextView android:id="@+id/widget_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="۰" android:textColor="#1A5E3A" android:textSize="21sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="left" android:text="تومان" android:textColor="#777777" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>