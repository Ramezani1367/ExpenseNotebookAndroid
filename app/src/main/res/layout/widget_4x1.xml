<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="rtl" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="خرج کرد امروز" android:textColor="#66806F" android:textSize="10sp" android:textStyle="bold" /><TextView android:id="@+id/widget_date_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="چهارشنبه" android:textColor="#234B36" android:textSize="14sp" android:textStyle="bold" /><TextView android:id="@+id/widget_date_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="۱ مرداد ۱۴۰۵" android:textColor="#8A978F" android:textSize="9sp" /></LinearLayout>
    <TextView android:id="@+id/widget_gear" android:layout_width="28dp" android:layout_height="32dp" android:gravity="center" android:text="⚙" android:textColor="#66806F" android:textSize="16sp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/widget_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="۰" android:textColor="#1A5E3A" android:textSize="21sp" android:textStyle="bold" /><TextView android:id="@+id/widget_currency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="تومان" android:textColor="#849188" android:textSize="9sp" /></LinearLayout>
    <TextView android:id="@+id/widget_plus" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="10dp" android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="23sp" android:background="@drawable/widget_plus_bg" />
    <TextView android:id="@+id/widget_items" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible" android:text="" />
</LinearLayout>